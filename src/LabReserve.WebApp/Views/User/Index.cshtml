@using LabReserve.Domain.Enums

@{
    ViewBag.Title = "Users";
    Layout = "_Layout";
}

@section Scripts {
    <script type="text/javascript">
        $(function () {
            const userTypes = {
                @((int)UserType.Professor): { label: 'Professor', css: 'text-bg-secondary' },
                @((int)UserType.Manager): { label: 'Manager', css: 'text-bg-info' },
                @((int)UserType.Admin): { label: 'Admin', css: 'text-bg-primary' }
            };

            window.select2.remote('#groups', '/group/list', {
                dropdownParent: $('#user-form-modal'),
                placeholder: 'Select groups',
                text: group => group.course ? `${group.name} · ${group.course.name}` : group.name
            });

            const table = window.tables.init('user-table', [
                {
                    data: null,
                    title: 'Name',
                    responsivePriority: 1,
                    render: user => window.utils.escapeHtml(`${user.firstName} ${user.lastName}`)
                },
                { data: 'email', title: 'Email', responsivePriority: 2, render: email => window.utils.escapeHtml(email) },
                { data: 'phone', title: 'Phone', render: phone => window.utils.escapeHtml(phone) },
                {
                    data: 'userType',
                    title: 'Type',
                    render: type => `<span class="badge ${userTypes[type]?.css ?? 'text-bg-light'}">${userTypes[type]?.label ?? type}</span>`
                }
            ], '/user/list');

            window.forms.setupEntityTable(table, 'user');

            $('#user-form').on('form:new', function () {
                $('#password').prop('required', true).attr('placeholder', 'Password');
                $('#password-help').addClass('d-none');
            });

            $('#user-form').on('form:loaded', function (event, user) {
                $('#password').prop('required', false).attr('placeholder', 'Password');
                $('#password-help').removeClass('d-none');
                window.select2.setSelected('#groups', user.groups.map(group => ({ id: group.id, text: group.name })));
            });
        });
    </script>
}

<div class="page-header">
    <div>
        <h1 class="page-title"><i class="bi bi-people me-2 text-primary"></i>Users</h1>
        <p class="page-subtitle">Professors, managers and administrators.</p>
    </div>
    <div class="page-actions">
        <button type="button" class="btn btn-primary" data-table-add="user-table">
            <i class="bi bi-plus-lg me-1"></i>New user
        </button>
    </div>
</div>

<div class="app-card">
    <div class="app-card-body">
        <table id="user-table"></table>
    </div>
</div>

<div class="modal fade" id="user-form-modal" data-entity-label="user" data-bs-backdrop="static" tabindex="-1"
    aria-labelledby="user-form-modal-label" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg modal-fullscreen-sm-down">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="user-form-modal-label">User</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="user-form" class="row g-3">
                    <div class="col-md-6">
                        <div class="form-floating">
                            <input type="text" class="form-control" id="firstName" name="firstName" placeholder="First name" maxlength="50" required>
                            <label for="firstName">First name</label>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-floating">
                            <input type="text" class="form-control" id="lastName" name="lastName" placeholder="Last name" maxlength="50" required>
                            <label for="lastName">Last name</label>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-floating">
                            <input type="email" class="form-control" id="email" name="email" placeholder="Email" maxlength="250" required>
                            <label for="email">Email</label>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-floating">
                            <input type="tel" class="form-control" id="phone" name="phone" placeholder="Phone" inputmode="numeric" minlength="10" maxlength="11" required>
                            <label for="phone">Phone (digits only)</label>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-floating">
                            <select class="form-select" id="userType" name="userType" data-type="number">
                                <option value="@((int)UserType.Professor)">Professor</option>
                                <option value="@((int)UserType.Manager)">Manager</option>
                                <option value="@((int)UserType.Admin)">Admin</option>
                            </select>
                            <label for="userType">Type</label>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-floating">
                            <input type="password" class="form-control" id="password" name="password" placeholder="Password" minlength="6" autocomplete="new-password">
                            <label for="password">Password</label>
                        </div>
                        <div class="form-text d-none" id="password-help">Leave blank to keep the current password.</div>
                    </div>
                    <div class="col-12">
                        <div class="select2-field">
                            <label for="groups">Groups</label>
                            <select id="groups" name="groups" data-type="number" multiple></select>
                        </div>
                    </div>
                    <input type="hidden" name="id" id="id" data-type="number" />
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="btnSubmitForm">Save</button>
            </div>
        </div>
    </div>
</div>
