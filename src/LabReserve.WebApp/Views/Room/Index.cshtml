@{
    ViewBag.Title = "Rooms";
    Layout = "_Layout";
}

@section Scripts {
    <script type="text/javascript">
        $(function () {
            const table = window.tables.init('room-table', [
                { data: 'name', title: 'Name', responsivePriority: 1 }
            ], '/room/list');

            window.forms.setupEntityTable(table, 'room');
        });
    </script>
}

<div class="page-header">
    <div>
        <h1 class="page-title"><i class="bi bi-door-open me-2 text-primary"></i>Rooms</h1>
        <p class="page-subtitle">Laboratories and rooms available for reservation.</p>
    </div>
    <div class="page-actions">
        <button type="button" class="btn btn-primary" data-table-add="room-table">
            <i class="bi bi-plus-lg me-1"></i>New room
        </button>
    </div>
</div>

<div class="app-card">
    <div class="app-card-body">
        <table id="room-table"></table>
    </div>
</div>

<div class="modal fade" id="room-form-modal" data-entity-label="room" data-bs-backdrop="static" tabindex="-1"
    aria-labelledby="room-form-modal-label" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-fullscreen-sm-down">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="room-form-modal-label">Room</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="room-form">
                    <div class="form-floating">
                        <input type="text" class="form-control" id="name" name="name" placeholder="Name" maxlength="50" required>
                        <label for="name">Name</label>
                    </div>
                    <input type="hidden" name="id" id="id" data-type="number" />
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="btnSubmitForm">Save</button>
            </div>
        </div>
    </div>
</div>
