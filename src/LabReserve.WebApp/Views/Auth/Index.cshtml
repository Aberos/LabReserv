@{
    ViewBag.Title = "Sign in";
    Layout = "_EmptyLayout";
}

@section Scripts {
    <script type="text/javascript">
        $(function () {
            $('#login-form').on('submit', function (event) {
                event.preventDefault();
                const submitButton = $('#submit-button').prop('disabled', true);
                $.ajax({
                    url: '/auth/sing-in',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(window.forms.serialize($(this))),
                    success: () => window.location.href = '/reservation',
                    error: window.toastMessage.error,
                    complete: () => submitButton.prop('disabled', false)
                });
            });
        });
    </script>
}

<div class="auth-page">
    <main class="auth-card">
        <div class="auth-brand">
            <i class="bi bi-calendar2-week"></i>
            <span>Lab Reserve</span>
        </div>
        <p class="text-center text-muted mb-4">Sign in to manage room reservations</p>

        <form id="login-form" class="d-grid gap-3">
            <div class="form-floating">
                <input type="email" class="form-control" id="email" name="email" placeholder="name@example.com" autocomplete="username" required autofocus>
                <label for="email">Email address</label>
            </div>
            <div class="form-floating">
                <input type="password" class="form-control" id="password" name="password" placeholder="Password" autocomplete="current-password" required>
                <label for="password">Password</label>
            </div>
            <button id="submit-button" class="btn btn-primary btn-lg" type="submit">Sign in</button>
        </form>
    </main>
</div>
